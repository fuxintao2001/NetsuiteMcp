#!/bin/sh
# Git pre-push hook: When pushing NetsuiteMcp, ensure dist is built, all workspace environments are synced, and error logs are cleaned.

echo "\n⚡ [Git Hook: pre-push] 确保构建最新 dist/ 产物并触发 MCP 热重载..."
npm run build

echo "\n🔄 [Git Hook: pre-push] 自动检查并同步各环境 AGENTS 与规约..."
node scripts/sync-agents.js --push

echo "\n🧹 [Git Hook: pre-push] 清空历史错误日志与诊断报告..."
node scripts/clean-error-logs.js
