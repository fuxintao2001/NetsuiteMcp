#!/bin/sh
# Git post-commit hook: Auto-sync workspace agents when commit includes workspace-agents/ or sync-agents.js
CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id HEAD)
if echo "$CHANGED_FILES" | grep -q -E "^(workspace-agents/|scripts/sync-agents\.js)"; then
  echo "\n🔄 [Git Hook: post-commit] 检测到 workspace-agents 变动，自动同步并推送到各环境远端..."
  node scripts/sync-agents.js --push
fi
